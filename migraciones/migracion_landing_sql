-- Migración para Landing Page (Sprint Landing E-commerce)
-- Crea la vista para ranking de productos más vendidos en ventas confirmadas real.
-- Idempotente (CREATE OR REPLACE VIEW)

CREATE OR REPLACE VIEW public.v_articulos_mas_vendidos AS
SELECT 
    vd.articulo_id,
    SUM(vd.cantidad)::integer AS total_vendido
FROM public.ventas_detalle vd
JOIN public.ventas v ON v.id = vd.venta_id
WHERE v.estado = 'Confirmada'
GROUP BY vd.articulo_id;

